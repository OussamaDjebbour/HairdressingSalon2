# Secrets for `pnpm new-salon` (scripts/new-salon.ts). Copy to .env.admin (git-ignored) and fill in.
# Never commit .env.admin: the service-role key bypasses every database rule.

# Supabase: Dashboard → Project Settings → API (project URL and the service_role / secret key).
# Local stack: API_URL and SERVICE_ROLE_KEY from `supabase status -o env`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare (leave CLOUDFLARE_API_TOKEN empty to skip attaching domains).
# Account id: Cloudflare dashboard → Account home → Account ID.
CLOUDFLARE_ACCOUNT_ID=
# API token with: Account → Cloudflare Pages: Edit; Zone → Zone: Read; Zone → DNS: Edit.
CLOUDFLARE_API_TOKEN=
# The Pages project that serves every salon (its site is <project>.pages.dev).
CLOUDFLARE_PAGES_PROJECT=salons
