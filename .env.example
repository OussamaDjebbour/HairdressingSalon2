VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Web Push public key (VAPID), see docs/notifications-setup.md
VITE_VAPID_PUBLIC_KEY=
# The salon is found from the web address (public.salon_domains; localhost -> elegance in the
# local seed). On localhost, add ?salon=<id> to the URL to open another salon.
# Optional, dev server only (ignored in production builds): always serve this salon.
# VITE_SALON_ID=elegance
